    "vazirmatn": "33.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.12",
    "@types/node": "22.15.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion@1.1.16": "1.1.17",
    "postcss@<=8.5.17": "8.5.25",
    "sharp@<0.35.0": "0.35.3"

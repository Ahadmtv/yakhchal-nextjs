{
  "name": "yakhchal-nextjs",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run check:architecture && npm run typecheck && npm run lint && npm run build && npm run test:production",
    "analyze": "ANALYZE=true next build",
    "audit:lighthouse": "node scripts/run-lighthouse.mjs",
    "capture:production": "node scripts/capture-production.mjs",
    "check:architecture": "node scripts/verify-architecture.mjs",
    "test:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
